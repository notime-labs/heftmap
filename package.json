{
  "name": "heftmap",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "version": "0.1.0",
  "publisher": "notime-labs",
  "author": {
    "name": "Notime Labs"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notime-labs/heftmap"
  },
  "homepage": "https://github.com/notime-labs/heftmap#readme",
  "bugs": {
    "url": "https://github.com/notime-labs/heftmap/issues"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "treemap",
    "file size",
    "disk usage",
    "unused files",
    "unused assets",
    "orphan files",
    "hotspots",
    "churn",
    "git history",
    "monorepo",
    "bundle size",
    "assets",
    "tamaño de archivos",
    "huérfanos",
    "euskara"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:heftmap.panel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "heftmap.publicDir",
        "heftmap.git.since",
        "heftmap.usage.ignore",
        "heftmap.usage.entryPoints",
        "heftmap.usage.weakSources",
        "heftmap.exclude",
        "heftmap.hotspots.exclude"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "heftmap",
          "title": "%container.title%",
          "icon": "media/heft.svg"
        }
      ]
    },
    "views": {
      "heftmap": [
        {
          "id": "heftmap.folders",
          "name": "%view.folders%",
          "icon": "media/heft.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "heftmap.folders",
        "contents": "%view.welcome%",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "heftmap.openPanel",
        "title": "%command.openPanel%",
        "category": "Heftmap",
        "icon": "$(table)"
      },
      {
        "command": "heftmap.refresh",
        "title": "%command.refresh%",
        "category": "Heftmap",
        "icon": "$(refresh)"
      },
      {
        "command": "heftmap.pickScope",
        "title": "%command.pickScope%",
        "category": "Heftmap",
        "icon": "$(filter)"
      },
      {
        "command": "heftmap.clearScope",
        "title": "%command.clearScope%",
        "category": "Heftmap",
        "icon": "$(clear-all)"
      },
      {
        "command": "heftmap.addToScope",
        "title": "%command.addToScope%",
        "category": "Heftmap"
      },
      {
        "command": "heftmap.limitScope",
        "title": "%command.limitScope%",
        "category": "Heftmap"
      },
      {
        "command": "heftmap.revealInExplorer",
        "title": "%command.revealInExplorer%",
        "category": "Heftmap"
      },
      {
        "command": "heftmap.exportTable",
        "title": "%command.exportTable%",
        "category": "Heftmap"
      },
      {
        "command": "heftmap.showLog",
        "title": "%command.showLog%",
        "category": "Heftmap"
      },
      {
        "command": "heftmap.copyReport",
        "title": "%command.copyReport%",
        "category": "Heftmap"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "heftmap.openPanel",
          "when": "view == heftmap.folders",
          "group": "navigation@0"
        },
        {
          "command": "heftmap.pickScope",
          "when": "view == heftmap.folders",
          "group": "navigation@1"
        },
        {
          "command": "heftmap.clearScope",
          "when": "view == heftmap.folders",
          "group": "navigation@2"
        },
        {
          "command": "heftmap.refresh",
          "when": "view == heftmap.folders",
          "group": "navigation@3"
        },
        {
          "command": "heftmap.showLog",
          "when": "view == heftmap.folders"
        },
        {
          "command": "heftmap.copyReport",
          "when": "view == heftmap.folders"
        }
      ],
      "view/item/context": [
        {
          "command": "heftmap.limitScope",
          "when": "view == heftmap.folders && viewItem == heftDir",
          "group": "heft@1"
        },
        {
          "command": "heftmap.revealInExplorer",
          "when": "view == heftmap.folders && viewItem =~ /^heft(Dir|File)$/",
          "group": "heft@2"
        }
      ],
      "explorer/context": [
        {
          "command": "heftmap.addToScope",
          "when": "explorerResourceIsFolder",
          "group": "heft@1"
        },
        {
          "command": "heftmap.limitScope",
          "when": "explorerResourceIsFolder",
          "group": "heft@2"
        }
      ],
      "commandPalette": [
        {
          "command": "heftmap.addToScope",
          "when": "false"
        },
        {
          "command": "heftmap.limitScope",
          "when": "false"
        },
        {
          "command": "heftmap.revealInExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "heftmap.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es",
            "eu"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Español",
            "Euskara"
          ],
          "description": "%config.language%"
        },
        "heftmap.publicDir": {
          "type": "string",
          "default": "public",
          "description": "%config.publicDir%"
        },
        "heftmap.git.since": {
          "type": "string",
          "default": "",
          "description": "%config.git.since%"
        },
        "heftmap.usage.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.usage.ignore%"
        },
        "heftmap.usage.entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.usage.entryPoints%"
        },
        "heftmap.refreshDelay": {
          "type": "number",
          "default": 1500,
          "minimum": 250,
          "maximum": 60000,
          "description": "%config.refreshDelay%"
        },
        "heftmap.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefresh%"
        },
        "heftmap.maxTextFileSize": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.maxTextFileSize%"
        },
        "heftmap.usage.weakSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "scripts",
            "tools",
            "bin"
          ],
          "description": "%config.usage.weakSources%"
        },
        "heftmap.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.exclude%"
        },
        "heftmap.hotspots.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.hotspots.exclude%"
        },
        "heftmap.panel.defaultArea": {
          "type": "string",
          "enum": [
            "bytes",
            "balanced",
            "lines"
          ],
          "default": "bytes",
          "description": "%config.panel.defaultArea%"
        },
        "heftmap.panel.defaultColor": {
          "type": "string",
          "enum": [
            "ext",
            "usage",
            "age",
            "recent",
            "changes"
          ],
          "default": "ext",
          "description": "%config.panel.defaultColor%"
        }
      }
    },
    "keybindings": [
      {
        "command": "heftmap.openPanel",
        "key": "ctrl+shift+alt+h",
        "mac": "cmd+ctrl+shift+h"
      }
    ],
    "walkthroughs": [
      {
        "id": "heftmap.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openPanel",
            "title": "%walkthrough.panel.title%",
            "description": "%walkthrough.panel.description%",
            "media": {
              "image": "docs/images/usage.png",
              "altText": "%walkthrough.panel.alt%"
            },
            "completionEvents": [
              "onCommand:heftmap.openPanel"
            ]
          },
          {
            "id": "scope",
            "title": "%walkthrough.scope.title%",
            "description": "%walkthrough.scope.description%",
            "media": {
              "image": "docs/images/age.png",
              "altText": "%walkthrough.scope.alt%"
            },
            "completionEvents": [
              "onCommand:heftmap.pickScope",
              "onCommand:heftmap.limitScope"
            ]
          },
          {
            "id": "noTrace",
            "title": "%walkthrough.noTrace.title%",
            "description": "%walkthrough.noTrace.description%",
            "media": {
              "image": "docs/images/usage.png",
              "altText": "%walkthrough.noTrace.alt%"
            }
          },
          {
            "id": "hotspots",
            "title": "%walkthrough.hotspots.title%",
            "description": "%walkthrough.hotspots.description%",
            "media": {
              "image": "docs/images/hotspots.png",
              "altText": "%walkthrough.hotspots.alt%"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:ext",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --external:typescript --outfile=dist/cli.js",
    "build:ext": "npm run build:host && npm run build:worker && npm run build:webview",
    "build:host": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --sourcemap --outfile=dist/extension.cjs",
    "build:worker": "esbuild src/extension/worker.ts --bundle --platform=node --format=cjs --target=node20 --minify --sourcemap --outfile=dist/worker.cjs",
    "build:webview": "esbuild src/webview/main.tsx --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview.js",
    "watch:ext": "npm run build:worker && npm run build:webview && npm run build:host -- --watch",
    "vscode:prepublish": "npm run build:ext",
    "package": "vsce package --no-dependencies --out heftmap.vsix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "heftmap": "node dist/cli.js"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
